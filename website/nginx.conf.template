server {
    # Vorgabe 5173 (alle Adressen) aus dem Dockerfile; der Homeserver setzt
    # NGINX_LISTEN=127.0.0.1:5173. Das nginx-Abbild ersetzt beim Start nur
    # gesetzte Umgebungsvariablen, $uri und Co. bleiben stehen.
    listen ${NGINX_LISTEN};
    server_name localhost;

    # Disable access logs for every request to reduce noise, keep errors
    access_log off;
    error_log /dev/stderr warn;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Die Einstiegsseite nennt die Bündel mit Prüfsumme im Namen. Ohne diese
    # Kopfzeile schätzt der Browser selbst, wie lange er sie behalten darf,
    # und fragt nach einem Deploy noch Stunden nach Bündeln, die es nicht mehr
    # gibt. "no-cache" heißt: behalten, aber vor jedem Gebrauch nachfragen.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Gebündelte Dateien: der Name ändert sich mit dem Inhalt, also dürfen sie
    # ewig im Cache liegen. Eine fehlende Datei ist ein echtes 404 – vorher kam
    # dafür die Einstiegsseite mit 200 zurück, und der Browser zeigte nach einem
    # Deploy eine weiße Seite ("MIME type text/html" statt Skript).
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Proxy API requests to the backend
    location /api/ {
        proxy_pass http://backend:8888/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Proxy Auth requests to the backend
    location /auth/ {
        proxy_pass http://backend:8888/auth/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
