server {
    # Vorgabe 5173 (alle Adressen) aus dem Dockerfile; der Homeserver setzt
    # NGINX_LISTEN=127.0.0.1:5173. Das nginx-Abbild ersetzt beim Start nur
    # gesetzte Umgebungsvariablen, $uri und Co. bleiben stehen.
    listen ${NGINX_LISTEN};
    server_name localhost;

    # Disable access logs for every request to reduce noise, keep errors
    access_log off;
    error_log /dev/stderr warn;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the backend
    location /api/ {
        proxy_pass http://backend:8888/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Proxy Auth requests to the backend
    location /auth/ {
        proxy_pass http://backend:8888/auth/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
